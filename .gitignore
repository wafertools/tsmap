# Host-specific working notes/plans belong in ../notes (separate, unpublished
# local repo), never here — backstop against an accidental `git add -A`.
/COLUMNAR_DATA.md
# Moved to ../notes/tsmap/ — the IDEAS.md link to this path is intentionally
# local-only now (see check-doc-links.mjs's isLocalOnly), same reasoning.
/plans/open-from-url-ingestion.md
.claude/
.mcp.json
CLAUDE.md
# Python bytecode from the scripts/generate_*.py sample-data generators
__pycache__/

# Test data files — these can be large or proprietary
*.stdf
*.std
*.atdf
*.atd
/testdata

# Scenario-runner checkpoint screenshots (scripts/run-scenario.mjs) —
# regenerated on every run, not the guide's docs/images.
/demo

# …but the curated samples published on the docs site must be committed
# (the *.stdf / *.atdf globs above match by extension regardless of directory,
#  so re-include the sample paths explicitly)
!/docs/samples/*.stdf
!/docs/samples/*.atdf

# Rust parser tests (packages/parsers) read fixtures from /sample_data — these
# must be committed or `npm run test:rust` fails on a clean CI checkout.
!/sample_data/*.stdf
!/sample_data/*.atdf
